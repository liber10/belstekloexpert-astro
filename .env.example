# Copy this file to .env for local Astro development.
# Never add real credentials, tokens, database URLs, or customer data here.

# Public analytics identifiers. These values are visible in the browser.
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
PUBLIC_YANDEX_METRIKA_ID=

# Astro site -> Lead Hub delivery.
# LEAD_DELIVERY_MODE: legacy | hub | hub-with-legacy-telegram
LEAD_DELIVERY_MODE=
LEAD_HUB_URL=http://127.0.0.1:8787
LEAD_HUB_TIMEOUT_MS=25000
WEB_INGEST_API_KEY=

# External integration inbox. Keep disabled until the matching secret is configured.
KUFAR_INGEST_ENABLED=false
KUFAR_INGEST_API_KEY=
INBOX_POLL_INTERVAL_MS=2000
INBOX_BATCH_SIZE=10
INBOX_MAX_ATTEMPTS=8
INBOX_PROCESSING_TIMEOUT_MS=300000

# Telegram. Keep disabled until all three secret fields are configured.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Lead Hub runtime and PostgreSQL.
NODE_ENV=development
DATABASE_URL=
TEST_DATABASE_URL=
LEAD_HUB_HOST=0.0.0.0
LEAD_HUB_PORT=8787
LEAD_HUB_PUBLIC_URL=http://127.0.0.1:8787
LEAD_HUB_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
LEAD_HUB_RATE_LIMIT_MAX=20

# Private S3-compatible object storage. Configure the full group or leave it empty.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=leads/
OBJECT_STORAGE_UPLOAD_TTL_SECONDS=900
OBJECT_STORAGE_DOWNLOAD_TTL_SECONDS=900

# Lead Hub outbox and logging.
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=8
LOG_LEVEL=info

# Private calculator inputs. The service component value must never be committed.
GLASS_SERVICE_COMPONENT_BYN=
GLASS_PRICE_USD_TO_BYN=3

{
  "name": "belstekloexpert-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/lead-hub"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:render": "astro check && astro build --config astro.config.render.mjs",
    "check": "astro check",
    "test:site": "vitest run tests/site-lead-client.test.ts",
    "preview": "astro preview",
    "prices:update": "node scripts/update-glass-prices.mjs",
    "lead-hub:dev": "npm run dev --workspace @belstekloexpert/lead-hub",
    "lead-hub:build": "npm run build --workspace @belstekloexpert/lead-hub",
    "lead-hub:test": "npm run test --workspace @belstekloexpert/lead-hub",
    "lead-hub:check": "npm run check --workspace @belstekloexpert/lead-hub"
  },
  "dependencies": {
    "@astrojs/netlify": "^7.0.13",
    "@astrojs/node": "^10.1.4",
    "astro": "^6.4.6",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/pg": "^8.20.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}

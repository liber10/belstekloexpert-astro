{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "belstekloexpert-production",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/images/*",
      "!/docs/*",
      "!/favicon.*",
      "!/apple-touch-icon.png",
      "!/byn-ico.svg",
      "!/robots.txt",
      "!/llms.txt",
      "!/yandex_*.html",
      "!/sitemap.xml"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "DEPLOY_ENV": "production",
    "LEAD_DELIVERY_MODE": "hub",
    "LEAD_HUB_URL": "https://belstekloexpert-astro.onrender.com",
    "LEAD_HUB_TIMEOUT_MS": "25000"
  }
}

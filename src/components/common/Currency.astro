---
interface Props {
  value: number | string;
  prefix?: string;
  suffix?: string;
  class?: string;
}

const {
  value,
  prefix = 'от ',
  suffix = '',
  class: className = '',
} = Astro.props;

const label = typeof value === 'number' ? value.toLocaleString('ru-RU') : String(value);
const ariaLabel = `${prefix}${label} белорусских рублей${suffix ? ` ${suffix}` : ''}`.trim();
---

<span class:list={['currency-inline', className]} aria-label={ariaLabel}>
  {prefix && <span>{prefix}</span>}
  <span>{label}</span>
  <img src="/byn-ico.svg" alt="" aria-hidden="true" loading="lazy" />
  {suffix && <span>{suffix}</span>}
</span>

---
import MessengerButtons from '@/components/common/MessengerButtons.astro';
import { businessHours } from '@/data/business-hours';
import { contacts } from '@/data/contacts';
import { serviceNavigation } from '@/data/navigation';
import { site } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <h2>{site.name}</h2>
        <p>
          Замена и ремонт автостёкол в Минске: подбор по VIN, работа со сколами,
          трещинами, боковыми и задними стёклами.
        </p>
        <MessengerButtons compact />
      </div>

      <div>
        <h3>Услуги</h3>
        <ul>
          {serviceNavigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/marki/">Марки авто</a></li>
          <li><a href="/dlya-yurlic/">Для юрлиц</a></li>
        </ul>
      </div>

      <div>
        <h3>Компания</h3>
        <ul>
          <li><a href="/o-kompanii/">О компании</a></li>
          <li><a href="/kejsy/">Кейсы</a></li>
          <li><a href="/otzyvy/">Отзывы</a></li>
          <li><a href={site.commercialOfferPath} data-event="commercial_offer_download">Коммерческое предложение</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/privacy/">Политика обработки данных</a></li>
          <li><button class="site-footer__link-button" type="button" data-cookie-settings>Настройки cookie</button></li>
        </ul>
      </div>

      <div>
        <h3>Контакты</h3>
        <ul>
          <li>{contacts.address}</li>
          <li><a href={contacts.phoneHref}>{contacts.phone}</a></li>
          <li>{businessHours.short}</li>
          <li><a href={contacts.yandexMaps} data-event="route_click">Яндекс Карты</a></li>
          <li><a href={contacts.googleMaps} data-event="route_click">Google Maps</a></li>
          <li><a href="/otzyv/">Оставить отзыв</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      © {year} {site.legalName}, УНП {site.unp}. Все права защищены.
    </div>
  </div>
</footer>

<script is:inline>
  document.querySelector('[data-cookie-settings]')?.addEventListener('click', () => {
    window.dispatchEvent(new Event('bse:cookie-settings'));
  });
</script>

---
import AttributionFields from '@/components/forms/AttributionFields.astro';
import ConsentNotice from '@/components/forms/ConsentNotice.astro';
import prices from '@/data/glass-prices.json';

interface Props {
  title?: string;
  service?: string;
  embedded?: boolean;
  windshieldOnly?: boolean;
}

const {
  title = 'Получить быструю оценку по фото',
  service = 'Оценка по фото',
  embedded = false,
  windshieldOnly = false,
} = Astro.props;
const photoLabel = windshieldOnly ? 'Фото лобового стекла' : 'Фото стекла или повреждения';
const photoInstruction = windshieldOnly
  ? 'Обязательное фото — лобовое стекло целиком снаружи. Для скола или трещины добавьте крупный план.'
  : 'Сфотографируйте нужное стекло целиком. Если есть повреждение, добавьте крупный план.';

const vehicleCatalog = [...prices.reduce((catalog, item) => {
  const current = catalog.get(item.brandKey) ?? {
    key: item.brandKey,
    label: item.brand,
    aliases: new Set<string>(),
    models: new Set<string>(),
  };

  current.aliases.add(item.brand);
  for (const alias of item.brandAliases ?? []) current.aliases.add(alias);
  current.models.add(item.model);
  catalog.set(item.brandKey, current);
  return catalog;
}, new Map<string, {
  key: string;
  label: string;
  aliases: Set<string>;
  models: Set<string>;
}>()).values()]
  .map((item) => ({
    key: item.key,
    label: item.label,
    aliases: [...item.aliases],
    models: [...item.models].sort((a, b) => a.localeCompare(b, 'ru', { numeric: true })),
  }))
  .sort((a, b) => a.label.localeCompare(b.label, 'ru'));

const vehicleCatalogJson = JSON.stringify(vehicleCatalog);
---

<div class:list={['form-panel', { 'form-panel--embedded': embedded }]} id="photo-estimate-form" data-photo-estimate-form>
  <div>
    <p class="section__eyebrow">Оценка мастером</p>
    <h2>{title}</h2>
    <p>
      Укажите марку, модель и год, затем приложите {windshieldOnly ? 'фото лобового стекла' : 'фото нужного стекла'}. Мастер сам
      увидит важные особенности и предложит подходящий вариант без анкеты про датчики.
    </p>
    <ol class="photo-estimate-steps" aria-label="Что нужно для оценки">
      <li><strong>Автомобиль</strong><span>Марка, модель и год выпуска</span></li>
      <li><strong>Фото стекла</strong><span>Целиком снаружи; повреждение — ещё и крупным планом</span></li>
      <li><strong>Ответ мастера</strong><span>Подходящий вариант, стоимость и время</span></li>
    </ol>
  </div>

  <form
    class="lead-form"
    action="/api/lead/"
    method="post"
    enctype="multipart/form-data"
    data-lead-form
    data-photo-compress-form
    data-vehicle-photo-form
    data-submit-event="photo_estimate_submit"
  >
    <input class="hp-field" type="text" name="company" tabindex="-1" autocomplete="off" />
    <input type="hidden" name="service" value={service} />
    <AttributionFields />

    <div class="lead-form__row">
      <label class="field">
        <span>Марка</span>
        <input
          name="make"
          list="quick-make-options"
          placeholder="Например: Volkswagen или Фольксваген"
          autocomplete="off"
          required
          data-quick-make
        />
        <datalist id="quick-make-options" data-quick-make-options></datalist>
      </label>
      <label class="field">
        <span>Модель</span>
        <input
          name="model"
          list="quick-model-options"
          placeholder="Сначала укажите марку"
          autocomplete="off"
          required
          data-quick-model
        />
        <datalist id="quick-model-options" data-quick-model-options></datalist>
      </label>
    </div>

    <div class="lead-form__row">
      <label class:list={['field', { 'field--wide': windshieldOnly }]}>
        <span>Год выпуска</span>
        <input
          name="year"
          type="number"
          inputmode="numeric"
          min="1950"
          max="2030"
          placeholder="Например: 2018"
          required
        />
      </label>
      {windshieldOnly ? (
        <input type="hidden" name="glass_type" value="Лобовое" />
      ) : (
        <label class="field">
          <span>Что нужно сделать</span>
          <select name="glass_type">
            <option>Лобовое стекло</option>
            <option>Ремонт скола</option>
            <option>Ремонт трещины</option>
            <option>Боковое стекло</option>
            <option>Заднее стекло</option>
            <option>Не знаю — нужна оценка</option>
          </select>
        </label>
      )}
    </div>

    <label class="field field--file">
      <span>{photoLabel}</span>
      <input
        name="photos"
        type="file"
        accept="image/jpeg,image/png,image/webp,image/heic,image/heif"
        multiple
        required
      />
      <small>
        {photoInstruction} До 5 фото; большие JPG, PNG и WebP сожмутся автоматически.
      </small>
    </label>

    <div class="lead-form__row">
      <label class="field">
        <span>Телефон</span>
        <input name="phone" inputmode="tel" autocomplete="tel" placeholder="+375 ..." required />
      </label>
      <label class="field">
        <span>Как ответить</span>
        <select name="contact_method">
          <option>Звонок</option>
          <option>Telegram</option>
          <option>Viber</option>
        </select>
      </label>
    </div>

    <label class="field">
      <span>Комментарий <small>(необязательно)</small></span>
      <textarea name="comment" placeholder="Например: нужен ремонт скола или замена стекла"></textarea>
    </label>

    <ConsentNotice />

    <p class="form-status" data-form-status aria-live="polite"></p>
    <button class="button button--primary" type="submit">Получить оценку по фото</button>
  </form>
</div>

<script is:inline type="application/json" data-quick-vehicle-catalog set:html={vehicleCatalogJson}></script>

<script is:inline>
  (() => {
    const normalize = (value) => String(value || '')
      .toLowerCase()
      .replaceAll('ё', 'е')
      .replace(/[^a-zа-я0-9]+/gi, ' ')
      .trim()
      .replace(/\s+/g, ' ');

    const escapeAttribute = (value) => String(value || '')
      .replaceAll('&', '&amp;')
      .replaceAll('"', '&quot;')
      .replaceAll('<', '&lt;');

    document.querySelectorAll('form[data-vehicle-photo-form]').forEach((form) => {
      if (!(form instanceof HTMLFormElement) || form.dataset.vehicleCatalogReady === 'true') return;

      const source = form.parentElement?.nextElementSibling;
      const makeInput = form.querySelector('[data-quick-make]');
      const modelInput = form.querySelector('[data-quick-model]');
      const makeOptions = form.querySelector('[data-quick-make-options]');
      const modelOptions = form.querySelector('[data-quick-model-options]');
      if (
        !(source instanceof HTMLScriptElement) ||
        !(makeInput instanceof HTMLInputElement) ||
        !(modelInput instanceof HTMLInputElement) ||
        !(makeOptions instanceof HTMLDataListElement) ||
        !(modelOptions instanceof HTMLDataListElement)
      ) return;

      const catalog = JSON.parse(source.textContent || '[]');
      form.dataset.vehicleCatalogReady = 'true';

      const lookup = catalog.flatMap((brand) => (
        brand.aliases.map((alias) => ({ brand, value: normalize(alias) }))
      ));

      makeOptions.innerHTML = catalog.flatMap((brand) => {
        const aliases = brand.aliases.filter((alias) => /^[а-я]/i.test(alias));
        return [brand.label, ...aliases].map((alias) => (
          `<option value="${escapeAttribute(alias)}" label="${escapeAttribute(brand.label)}"></option>`
        ));
      }).join('');

      const findBrand = (value) => {
        const query = normalize(value);
        if (!query) return null;
        const exact = lookup.find((entry) => entry.value === query);
        if (exact) return exact.brand;
        if (query.length < 2) return null;
        const matches = lookup.filter((entry) => entry.value.startsWith(query));
        const keys = [...new Set(matches.map((entry) => entry.brand.key))];
        return keys.length === 1 ? matches.find((entry) => entry.brand.key === keys[0])?.brand : null;
      };

      const updateModels = () => {
        const brand = findBrand(makeInput.value);
        const models = brand?.models || [];
        modelOptions.innerHTML = models
          .map((model) => `<option value="${escapeAttribute(model)}"></option>`)
          .join('');
        modelInput.placeholder = brand
          ? `Например: ${models[0] || 'модель автомобиля'}`
          : makeInput.value.trim()
            ? 'Введите модель вручную'
            : 'Сначала укажите марку';
      };

      makeInput.addEventListener('input', () => {
        modelInput.value = '';
        updateModels();
      });
      updateModels();
    });
  })();
</script>

<script is:inline>
  (() => {
    const maxPhotoCount = 5;
    const maxServerBytes = 10 * 1024 * 1024;
    const targetBytes = 2 * 1024 * 1024;
    const maxImageSide = 1600;
    const compressibleTypes = new Set(['image/jpeg', 'image/png', 'image/webp']);

    document.querySelectorAll('form[data-photo-compress-form]').forEach((form) => {
      if (!(form instanceof HTMLFormElement) || form.dataset.photoCompressReady === 'true') return;

      form.dataset.photoCompressReady = 'true';
      const input = form.querySelector('input[type="file"][name="photos"]');
      const status = form.querySelector('[data-form-status]');
      const submitButton = form.querySelector('button[type="submit"]');

      if (!(input instanceof HTMLInputElement)) return;

      input.addEventListener('change', () => {
        const files = getSelectedFiles(input);
        if (!files.length) {
          setStatus(status, '');
          return;
        }

        if (files.length > maxPhotoCount) {
          setStatus(status, `Можно отправить не более ${maxPhotoCount} фото.`, 'error');
          return;
        }

        const largeHeicFile = files.find((file) => file.size > maxServerBytes && isHeicFile(file));
        if (largeHeicFile) {
          setStatus(status, getHeicTooLargeMessage(largeHeicFile), 'error');
          return;
        }

        const unsupportedLargeFile = files.find(
          (file) => file.size > maxServerBytes && !compressibleTypes.has(file.type),
        );
        if (unsupportedLargeFile) {
          setStatus(
            status,
            `Файл ${unsupportedLargeFile.name || 'photo'} больше 10 МБ. Лучше выбрать JPG, PNG или WebP.`,
            'error',
          );
          return;
        }

        setStatus(status, `Выбрано ${files.length} фото. Подготовим перед отправкой.`, 'info');
      });

      form.addEventListener('submit', async (event) => {
        const files = getSelectedFiles(input);
        if (!files.length || !window.fetch || !window.FormData || typeof HTMLCanvasElement === 'undefined') {
          return;
        }

        event.preventDefault();

        const consentAt = form.querySelector('[data-consent-at]');
        if (consentAt instanceof HTMLInputElement) consentAt.value = new Date().toISOString();

        const honeypot = form.querySelector('[name="company"]');
        if (honeypot instanceof HTMLInputElement && honeypot.value) return;

        const phone = form.querySelector('[name="phone"]');
        const digits = phone instanceof HTMLInputElement ? phone.value.replace(/\D/g, '') : '';
        if (digits.length < 9) {
          setStatus(status, 'Укажите телефон, чтобы мастер смог связаться с вами.', 'error');
          phone instanceof HTMLInputElement && phone.focus();
          return;
        }

        if (files.length > maxPhotoCount) {
          setStatus(status, `Можно отправить не более ${maxPhotoCount} фото.`, 'error');
          return;
        }

        setBusy(submitButton, true);
        setStatus(status, 'Готовим фото...', 'info');

        try {
          const formData = new FormData(form);
          formData.delete('photos');
          const preparedFiles = [];

          for (const [index, file] of files.entries()) {
            setStatus(status, `Готовим фото ${index + 1} из ${files.length}...`, 'info');
            const preparedFile = await preparePhoto(file);
            preparedFiles.push(preparedFile);
          }

          const photoRefs = await uploadPreparedPhotos(preparedFiles, formData, status);
          if (photoRefs) {
            for (const photoRef of photoRefs) formData.append('photo_refs', photoRef);
          } else {
            for (const preparedFile of preparedFiles) {
              formData.append('photos', preparedFile, preparedFile.name || 'photo');
            }
          }

          setStatus(status, 'Отправляем заявку...', 'info');
          const response = await fetch(form.action, {
            method: form.method || 'POST',
            body: formData,
            headers: { Accept: 'application/json' },
          });
          const payload = await response.json().catch(() => ({}));

          if (!response.ok || payload.ok === false) {
            throw new Error(payload.message || 'Не удалось отправить заявку. Попробуйте ещё раз.');
          }

          if (typeof window.bseTrack === 'function') {
            window.bseTrack('lead_success', {
              form_service: form.querySelector('[name="service"]')?.value || 'Оценка по фото',
              photo_count: files.length,
            });
          }

          const thanksUrl = new URL('/spasibo/', window.location.origin);
          if (payload.leadId) thanksUrl.searchParams.set('leadId', payload.leadId);
          window.location.href = thanksUrl.toString();
        } catch (error) {
          const message =
            error instanceof Error ? error.message : 'Не удалось отправить заявку. Попробуйте ещё раз.';
          setStatus(status, message, 'error');
          setBusy(submitButton, false);
        }
      });
    });

    function getSelectedFiles(input) {
      return Array.from(input.files || []).filter((file) => file.size > 0);
    }

    async function uploadPreparedPhotos(files, formData, status) {
      if (!window.crypto?.subtle || typeof File.prototype.arrayBuffer !== 'function') return null;

      const submissionId = ensureSubmissionId(formData);
      const descriptors = [];
      for (const [index, file] of files.entries()) {
        setStatus(status, `\u041f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c \u0444\u043e\u0442\u043e ${index + 1} \u0438\u0437 ${files.length}...`, 'info');
        descriptors.push({
          contentType: file.type,
          size: file.size,
          sha256: await sha256File(file),
        });
      }

      let response;
      try {
        response = await fetch('/api/uploads/prepare/', {
          method: 'POST',
          credentials: 'same-origin',
          cache: 'no-store',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ submissionId, files: descriptors }),
        });
      } catch {
        return null;
      }

      const payload = await response.json().catch(() => ({}));
      if (response.status === 503 && payload.error === 'storage_unavailable') return null;
      if (!response.ok || payload.ok === false || !Array.isArray(payload.uploads)) {
        throw new Error('\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0443 \u0444\u043e\u0442\u043e. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437.');
      }
      if (payload.uploads.length !== files.length) {
        throw new Error('\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c \u0432\u0441\u0435 \u0444\u043e\u0442\u043e. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437.');
      }

      const references = [];
      for (const [index, file] of files.entries()) {
        const upload = parsePreparedUpload(payload.uploads[index], file.type);
        if (!upload) throw new Error('\u041f\u043e\u043b\u0443\u0447\u0435\u043d \u043d\u0435\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u044b\u0439 \u0430\u0434\u0440\u0435\u0441 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u0444\u043e\u0442\u043e.');

        setStatus(status, `\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u043c \u0444\u043e\u0442\u043e ${index + 1} \u0438\u0437 ${files.length}...`, 'info');
        let uploadResponse;
        try {
          uploadResponse = await fetch(upload.uploadUrl, {
            method: 'PUT',
            credentials: 'omit',
            cache: 'no-store',
            headers: upload.headers,
            body: file,
          });
        } catch {
          throw new Error('\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0444\u043e\u0442\u043e. \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435 \u0438 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437.');
        }
        if (!uploadResponse.ok) {
          throw new Error('\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0444\u043e\u0442\u043e. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437.');
        }
        references.push(upload.ref);
      }

      return references;
    }

    function ensureSubmissionId(formData) {
      const current = formData.get('submission_id');
      if (typeof current === 'string' && /^[A-Za-z0-9_-]{8,160}$/.test(current)) return current;
      const random = window.crypto?.randomUUID?.().replaceAll('-', '') || Math.random().toString(36).slice(2);
      const submissionId = `lead_${Date.now().toString(36)}_${random}`;
      formData.set('submission_id', submissionId);
      return submissionId;
    }

    function parsePreparedUpload(value, expectedContentType) {
      if (!value || typeof value !== 'object') return null;
      if (typeof value.ref !== 'string' || !value.ref.startsWith('b2://')) return null;
      if (typeof value.uploadUrl !== 'string') return null;
      try {
        if (new URL(value.uploadUrl).protocol !== 'https:') return null;
      } catch {
        return null;
      }
      if (!value.headers || typeof value.headers !== 'object') return null;
      const headers = Object.fromEntries(
        Object.entries(value.headers).filter(([, header]) => typeof header === 'string'),
      );
      if (headers['content-type'] !== expectedContentType) return null;
      return { ref: value.ref, uploadUrl: value.uploadUrl, headers };
    }

    async function sha256File(file) {
      const digest = await window.crypto.subtle.digest('SHA-256', await file.arrayBuffer());
      return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0')).join('');
    }
    async function preparePhoto(file) {
      if (!compressibleTypes.has(file.type)) {
        if (file.size > maxServerBytes) {
          if (isHeicFile(file)) throw new Error(getHeicTooLargeMessage(file));
          throw new Error(`Файл ${file.name || 'photo'} больше 10 МБ. Сохраните его как JPG, PNG или WebP.`);
        }
        return file;
      }

      const { image, revoke } = await loadImage(file);
      try {
        const largestSide = Math.max(image.naturalWidth, image.naturalHeight);
        const needsResize = largestSide > maxImageSide;
        const needsCompression = file.size > targetBytes || needsResize || file.type !== 'image/jpeg';

        if (!needsCompression && file.size <= maxServerBytes) return file;

        let bestBlob = null;
        let sideLimit = maxImageSide;
        let quality = 0.82;

        for (let attempt = 0; attempt < 7; attempt += 1) {
          const scale = Math.min(1, sideLimit / largestSide);
          const width = Math.max(1, Math.round(image.naturalWidth * scale));
          const height = Math.max(1, Math.round(image.naturalHeight * scale));
          const blob = await renderJpeg(image, width, height, quality);

          if (!bestBlob || blob.size < bestBlob.size) bestBlob = blob;
          if (blob.size <= targetBytes) break;

          quality = Math.max(0.58, quality - 0.08);
          if (attempt >= 2) sideLimit = Math.max(900, Math.round(sideLimit * 0.82));
        }

        if (!bestBlob) throw new Error(`Не удалось подготовить файл ${file.name || 'photo'}.`);
        if (bestBlob.size >= file.size && file.size <= maxServerBytes) return file;
        if (bestBlob.size > maxServerBytes) {
          throw new Error(`Файл ${file.name || 'photo'} не удалось сжать до 10 МБ.`);
        }

        return new File([bestBlob], toJpegName(file.name), {
          type: 'image/jpeg',
          lastModified: Date.now(),
        });
      } finally {
        revoke();
      }
    }

    function loadImage(file) {
      return new Promise((resolve, reject) => {
        const url = URL.createObjectURL(file);
        const image = new Image();
        image.decoding = 'async';
        image.onload = () => resolve({ image, revoke: () => URL.revokeObjectURL(url) });
        image.onerror = () => {
          URL.revokeObjectURL(url);
          reject(new Error(`Не удалось открыть файл ${file.name || 'photo'} для сжатия.`));
        };
        image.src = url;
      });
    }

    function renderJpeg(image, width, height, quality) {
      return new Promise((resolve, reject) => {
        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;

        const context = canvas.getContext('2d');
        if (!context) {
          reject(new Error('Браузер не смог подготовить фото.'));
          return;
        }

        context.fillStyle = '#ffffff';
        context.fillRect(0, 0, width, height);
        context.drawImage(image, 0, 0, width, height);
        canvas.toBlob(
          (blob) => {
            if (blob) resolve(blob);
            else reject(new Error('Браузер не смог сжать фото.'));
          },
          'image/jpeg',
          quality,
        );
      });
    }

    function toJpegName(name) {
      const base = (name || 'photo').replace(/\.[^.]+$/, '') || 'photo';
      return `${base}-compressed.jpg`;
    }

    function isHeicFile(file) {
      const name = (file.name || '').toLowerCase();
      return (
        file.type === 'image/heic' ||
        file.type === 'image/heif' ||
        name.endsWith('.heic') ||
        name.endsWith('.heif')
      );
    }

    function getHeicTooLargeMessage(file) {
      const name = file.name ? `${file.name}: ` : '';
      return `${name}Фото iPhone в HEIC слишком большое. Выберите отправку как JPG или сделайте скрин/фото в совместимом формате.`;
    }

    function setStatus(status, message, state = 'info') {
      if (!status) return;
      status.textContent = message;
      if (message) status.setAttribute('data-state', state);
      else status.removeAttribute('data-state');
    }

    function setBusy(button, isBusy) {
      if (button instanceof HTMLButtonElement) button.disabled = isBusy;
    }
  })();
</script>

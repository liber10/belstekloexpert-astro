---
import VinPhotoForm from '@/components/forms/VinPhotoForm.astro';
import prices from '../data/glass-prices.json';

const calculatorPrices = prices.map((item) => ({
  id: item.id,
  brand: item.brand,
  brandKey: item.brandKey,
  brandAliases: item.brandAliases,
  model: item.model,
  modelKey: item.modelKey,
  glassType: item.glassType,
  glassTypeLabel: item.glassTypeLabel,
  name: item.name,
  eurocode: item.eurocode,
  years: item.years,
  fromYear: item.fromYear,
  toYear: item.toYear,
  yearOptions: item.yearOptions,
  totalPriceByn: item.totalPriceByn,
  searchText: item.searchText,
}));

const dataJson = JSON.stringify(calculatorPrices);
---

<section class="section section--soft glass-calculator" id="calculator" aria-labelledby="glass-calculator-title">
  <div class="container glass-calculator__inner">
    <div class="glass-calculator__copy">
      <p class="glass-calculator__eyebrow">Быстрая оценка</p>
      <h2 id="glass-calculator-title">Покажите лобовое стекло мастеру</h2>
      <p>
        Для первой оценки достаточно марки, модели, года автомобиля и фотографии
        лобового стекла. Специалист сам заметит датчики, камеру, обогрев и другие
        особенности, которые клиенту сложно определить по списку.
      </p>
      <p class="glass-calculator__note">
        Сфотографируйте стекло целиком снаружи. Если есть скол или трещина, добавьте
        второй снимок крупным планом — мастер сразу оценит шанс на ремонт.
      </p>
      <a class="glass-calculator__chip-link" href="/remont-skolov/">
        Есть скол? Не откладывайте оценку
      </a>
    </div>

    <div class="glass-calculator__panel" data-calculator>
      <div class="glass-calculator__tabs" role="tablist" aria-label="Выбор способа расчёта">
        <button
          class="glass-calculator__tab is-active"
          type="button"
          role="tab"
          aria-selected="true"
          data-mode-button="photo"
        >
          Оценка по фото
        </button>
        <button
          class="glass-calculator__tab"
          type="button"
          role="tab"
          aria-selected="false"
          data-mode-button="catalog"
        >
          Прайс-калькулятор
        </button>
      </div>

      <div class="glass-calculator__mode" data-mode-panel="photo">
        <VinPhotoForm
          title="Марка, модель, год и фото"
          service="Калькулятор: оценка лобового стекла по фото"
          embedded
          windshieldOnly
        />
      </div>

      <div class="glass-calculator__mode" data-mode-panel="catalog" hidden>
        <div class="glass-calculator__catalog-intro">
          <h3>Ориентир по прайсу поставщика</h3>
          <p>
            Выберите стекло и автомобиль, чтобы увидеть предварительный диапазон.
            Каталог продолжим расширять прайсами и API других поставщиков.
          </p>
        </div>
        <div class="glass-calculator__fields">
          <div class="glass-calculator__field">
            <label class="glass-calculator__label" for="glass-type">Тип стекла</label>
            <select id="glass-type" class="glass-calculator__select" data-glass-type>
              <option value="windshield">Лобовое стекло</option>
              <option value="side">Боковое стекло</option>
              <option value="rear">Заднее стекло</option>
            </select>
          </div>

          <div class="glass-calculator__field">
            <label class="glass-calculator__label" for="glass-brand">Марка</label>
            <input
              id="glass-brand"
              class="glass-calculator__input"
              type="text"
              list="glass-brand-options"
              placeholder="Например: Peugeot или Пежо"
              autocomplete="off"
              data-brand-input
            />
            <datalist id="glass-brand-options" data-brand-options></datalist>
          </div>

          <div class="glass-calculator__field">
            <label class="glass-calculator__label" for="glass-model">Модель</label>
            <input
              id="glass-model"
              class="glass-calculator__input"
              type="text"
              list="glass-model-options"
              placeholder="Сначала выберите марку"
              autocomplete="off"
              disabled
              data-model-input
            />
            <datalist id="glass-model-options" data-model-options></datalist>
          </div>

          <div class="glass-calculator__field">
            <label class="glass-calculator__label" for="glass-year">Год выпуска</label>
            <select id="glass-year" class="glass-calculator__select" disabled data-year-select>
              <option value="">Любой подходящий год</option>
            </select>
          </div>

          <div class="glass-calculator__field glass-calculator__field--wide">
            <label class="glass-calculator__label" for="glass-eurocode">Еврокод / комплектация</label>
            <select id="glass-eurocode" class="glass-calculator__select" disabled data-code-select>
              <option value="">Все подходящие еврокоды</option>
            </select>
          </div>
        </div>

        <div class="glass-calculator__helper" data-helper>
          Начните с типа стекла и марки. Марку можно вводить по-русски.
        </div>

        <div class="glass-calculator__range" data-range-summary hidden>
          <span>Ориентировочная стоимость с установкой, белорусские рубли</span>
          <strong data-range-price></strong>
          <small data-range-meta></small>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline type="application/json" id="glass-prices-json" set:html={dataJson}></script>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-calculator]');
    const source = document.getElementById('glass-prices-json');

    if (!root || !source) return;

    const prices = JSON.parse(source.textContent || '[]');
    const modeButtons = [...root.querySelectorAll('[data-mode-button]')];
    const modePanels = [...root.querySelectorAll('[data-mode-panel]')];

    const glassType = root.querySelector('[data-glass-type]');
    const brandInput = root.querySelector('[data-brand-input]');
    const brandOptions = root.querySelector('[data-brand-options]');
    const modelInput = root.querySelector('[data-model-input]');
    const modelOptions = root.querySelector('[data-model-options]');
    const yearSelect = root.querySelector('[data-year-select]');
    const codeSelect = root.querySelector('[data-code-select]');
    const helper = root.querySelector('[data-helper]');
    const rangeSummary = root.querySelector('[data-range-summary]');
    const rangePrice = root.querySelector('[data-range-price]');
    const rangeMeta = root.querySelector('[data-range-meta]');

    const normalize = (value) => String(value || '')
      .toLowerCase()
      .replaceAll('ё', 'е')
      .replace(/[^a-zа-я0-9]+/gi, ' ')
      .trim()
      .replace(/\s+/g, ' ');

    const formatBynNumber = (value) => Math.round(Number(value)).toLocaleString('ru-RU');
    const formatBynLabel = (value) => `${formatBynNumber(value)} белорусских рублей`;
    const formatBynHtml = (value) => {
      const label = formatBynLabel(value);
      return `
        <span class="glass-calculator__currency" aria-label="${label}">
          <span>${formatBynNumber(value)}</span>
          <span class="glass-calculator__currency-icon" aria-hidden="true"></span>
        </span>
      `;
    };

    const brands = [...prices.reduce((map, item) => {
      if (!map.has(item.brandKey)) {
        map.set(item.brandKey, {
          key: item.brandKey,
          label: item.brand,
          aliases: new Set([item.brand, ...(item.brandAliases || [])]),
        });
      } else {
        const entry = map.get(item.brandKey);
        entry.aliases.add(item.brand);
        for (const alias of item.brandAliases || []) entry.aliases.add(alias);
      }
      return map;
    }, new Map()).values()].sort((a, b) => a.label.localeCompare(b.label, 'ru'));

    const brandLookupValues = brands.flatMap((brand) => (
      [...brand.aliases].map((alias) => ({
        key: brand.key,
        label: brand.label,
        value: normalize(alias),
      }))
    ));

    const setOptions = (select, options, placeholder) => {
      select.innerHTML = `<option value="">${placeholder}</option>${options.join('')}`;
    };

    const escapeAttribute = (value) => String(value || '').replaceAll('&', '&amp;').replaceAll('"', '&quot;').replaceAll('<', '&lt;');

    const populateBrandOptions = () => {
      const optionValues = new Map();

      for (const brand of brands) {
        optionValues.set(brand.label, brand.label);
        for (const alias of brand.aliases) {
          if (/^[а-я]/i.test(alias)) optionValues.set(alias, brand.label);
        }
      }

      brandOptions.innerHTML = [...optionValues.entries()]
        .sort(([a], [b]) => a.localeCompare(b, 'ru'))
        .map(([value, label]) => `<option value="${escapeAttribute(value)}" label="${escapeAttribute(label)}"></option>`)
        .join('');
    };

    const findBrand = (value) => {
      const query = normalize(value);
      if (!query) return null;

      const exact = brandLookupValues.find((entry) => entry.value === query);
      if (exact) return brands.find((brand) => brand.key === exact.key) || null;

      if (query.length < 2) return null;
      const prefixMatches = brandLookupValues.filter((entry) => entry.value.startsWith(query));
      const uniqueKeys = [...new Set(prefixMatches.map((entry) => entry.key))];
      return uniqueKeys.length === 1 ? brands.find((brand) => brand.key === uniqueKeys[0]) || null : null;
    };

    const getTypeFilteredRows = () => prices.filter((item) => item.glassType === glassType.value);

    const getSelectedBrand = () => findBrand(brandInput.value);

    const getBrandRows = () => {
      const brand = getSelectedBrand();
      if (!brand) return [];
      return getTypeFilteredRows().filter((item) => item.brandKey === brand.key);
    };

    const getModelEntries = () => {
      const rows = getBrandRows();
      const models = rows.reduce((map, item) => {
        if (!map.has(item.modelKey)) map.set(item.modelKey, item.model);
        return map;
      }, new Map());

      return [...models.entries()]
        .map(([key, label]) => ({ key, label }))
        .sort((a, b) => a.label.localeCompare(b.label, 'ru', { numeric: true }));
    };

    const findModel = (value) => {
      const query = normalize(value);
      if (!query) return null;

      const models = getModelEntries();
      const exact = models.find((model) => model.key === query || normalize(model.label) === query);
      if (exact) return exact;

      if (query.length < 2) return null;
      const prefixMatches = models.filter((model) => model.key.startsWith(query) || normalize(model.label).startsWith(query));
      return prefixMatches.length === 1 ? prefixMatches[0] : null;
    };

    const getModelRows = () => {
      const model = findModel(modelInput.value);
      if (!model) return [];
      return getBrandRows().filter((item) => item.modelKey === model.key);
    };

    const getFilteredRows = () => {
      let rows = getModelRows();
      const selectedYear = Number(yearSelect.value);
      const selectedCode = codeSelect.value;

      if (selectedYear) {
        rows = rows.filter((item) => (item.yearOptions || []).includes(selectedYear));
      }

      if (selectedCode) {
        rows = rows.filter((item) => String(item.id) === selectedCode);
      }

      return rows;
    };

    const updateModelOptions = () => {
      const brand = getSelectedBrand();
      const models = brand ? getModelEntries() : [];

      modelInput.disabled = !brand;
      modelInput.placeholder = brand ? 'Начните вводить модель' : 'Сначала выберите марку';
      modelOptions.innerHTML = models
        .map((model) => `<option value="${escapeAttribute(model.label)}"></option>`)
        .join('');

      const selectedModel = findModel(modelInput.value);
      if (modelInput.value && !selectedModel) modelInput.value = '';
    };

    const updateYearOptions = () => {
      const selectedValue = yearSelect.value;
      const rows = getModelRows();
      const years = [...new Set(rows.flatMap((item) => item.yearOptions || []))]
        .sort((a, b) => b - a);

      yearSelect.disabled = !rows.length;
      setOptions(
        yearSelect,
        years.map((year) => `<option value="${year}">${year}</option>`),
        rows.length ? 'Любой подходящий год' : 'Сначала выберите модель',
      );

      if (selectedValue && years.includes(Number(selectedValue))) {
        yearSelect.value = selectedValue;
      }
    };

    const shortenName = (item) => item.name
      .replace(new RegExp(`^${item.brand}\\s+`, 'i'), '')
      .replace(/\s+/g, ' ')
      .trim();

    const updateCodeOptions = () => {
      const selectedValue = codeSelect.value;
      const rows = getModelRows().filter((item) => {
        const selectedYear = Number(yearSelect.value);
        return !selectedYear || (item.yearOptions || []).includes(selectedYear);
      });

      codeSelect.disabled = !rows.length;
      setOptions(
        codeSelect,
        rows
          .slice()
          .sort((a, b) => a.totalPriceByn - b.totalPriceByn || a.eurocode.localeCompare(b.eurocode))
          .map((item) => {
            const label = [item.eurocode, item.years, shortenName(item)].filter(Boolean).join(' · ');
            return `<option value="${item.id}">${escapeAttribute(label)}</option>`;
          }),
        rows.length ? 'Все подходящие еврокоды' : 'Сначала выберите модель',
      );

      if (selectedValue && rows.some((item) => String(item.id) === selectedValue)) {
        codeSelect.value = selectedValue;
      }
    };

    const renderRange = () => {
      const brand = getSelectedBrand();
      const model = findModel(modelInput.value);

      if (!brand) {
        rangeSummary.hidden = true;
        helper.textContent = 'Начните с типа стекла и марки. Марку можно вводить по-русски.';
        return;
      }

      if (!model) {
        rangeSummary.hidden = true;
        helper.textContent = 'Выберите модель из списка, чтобы сузить расчёт.';
        return;
      }

      const rows = getFilteredRows();
      if (!rows.length) {
        rangeSummary.hidden = true;
        helper.textContent = 'По выбранным параметрам в этом прайсе ничего не найдено. Переключитесь на оценку по фото.';
        return;
      }

      const totals = rows.map((item) => Number(item.totalPriceByn));
      const min = Math.min(...totals);
      const max = Math.max(...totals);
      const codeText = codeSelect.value ? ' выбранному еврокоду' : `${rows.length} подходящим позициям`;

      rangePrice.innerHTML = min === max
        ? formatBynHtml(min)
        : `${formatBynHtml(min)} <span class="glass-calculator__range-dash">–</span> ${formatBynHtml(max)}`;
      rangePrice.setAttribute('aria-label', min === max ? formatBynLabel(min) : `${formatBynLabel(min)} – ${formatBynLabel(max)}`);
      rangeMeta.textContent = `Диапазон рассчитан по ${codeText}. Для подтверждения варианта отправьте фото лобового стекла.`;
      helper.textContent = 'Диапазон показан с установкой. Точный вариант мастер подтвердит по фото.';
      rangeSummary.hidden = false;
    };

    const updateCalculator = ({ resetModel = false, resetYear = false, resetCode = false } = {}) => {
      if (resetModel) modelInput.value = '';
      if (resetYear) yearSelect.value = '';
      if (resetCode) codeSelect.value = '';

      updateModelOptions();
      updateYearOptions();
      updateCodeOptions();
      renderRange();
    };

    const setMode = (mode) => {
      modeButtons.forEach((button) => {
        const isActive = button.dataset.modeButton === mode;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-selected', String(isActive));
      });

      modePanels.forEach((panel) => {
        panel.hidden = panel.dataset.modePanel !== mode;
      });

      if (mode === 'catalog') brandInput?.focus();
      if (mode === 'photo') root.querySelector('[data-quick-make]')?.focus();
    };

    modeButtons.forEach((button) => {
      button.addEventListener('click', () => setMode(button.dataset.modeButton));
    });

    glassType.addEventListener('change', () => updateCalculator({ resetModel: true, resetYear: true, resetCode: true }));
    brandInput.addEventListener('input', () => updateCalculator({ resetModel: true, resetYear: true, resetCode: true }));
    modelInput.addEventListener('input', () => updateCalculator({ resetYear: true, resetCode: true }));
    yearSelect.addEventListener('change', () => updateCalculator({ resetCode: true }));
    codeSelect.addEventListener('change', () => renderRange());

    populateBrandOptions();
    updateCalculator();
  })();
</script>

<style>
  .glass-calculator {
    position: relative;
  }

  .glass-calculator__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
    gap: 32px;
    align-items: start;
  }

  .anchor-offset {
    position: absolute;
    top: -92px;
  }

  .glass-calculator__eyebrow {
    margin: 0 0 10px;
    font-size: 0.82rem;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--green);
  }

  .glass-calculator h2 {
    margin: 0 0 18px;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.05;
    color: var(--ink);
  }

  .glass-calculator h3 {
    margin: 0 0 10px;
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--ink);
  }

  .glass-calculator__copy p,
  .glass-calculator__catalog-intro p,
  .glass-calculator__form-note {
    margin: 0 0 16px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--muted);
  }

  .glass-calculator__note {
    padding: 16px 18px;
    border-left: 4px solid var(--green);
    border-radius: 8px;
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .glass-calculator__chip-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 4px;
    color: var(--green-dark);
    font-weight: 900;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .glass-calculator__panel {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .glass-calculator__tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 24px;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.76);
  }

  .glass-calculator__catalog-intro {
    margin-bottom: 20px;
  }

  .glass-calculator__panel :global(.form-panel--embedded) {
    grid-template-columns: 1fr;
    gap: 22px;
    border: 0;
    padding: 0;
    box-shadow: none;
  }

  .glass-calculator__panel :global(.form-panel--embedded h2) {
    font-size: 1.55rem;
  }

  .glass-calculator__panel :global(.photo-estimate-steps) {
    margin-top: 18px;
  }

  .glass-calculator__tab {
    min-height: 54px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .glass-calculator__tab.is-active {
    background: var(--white);
    color: var(--ink);
    box-shadow: var(--shadow);
  }

  .glass-calculator__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .glass-calculator__field--wide {
    grid-column: 1 / -1;
  }

  .glass-calculator__label {
    display: block;
    margin: 0 0 10px;
    font-weight: 700;
    color: var(--ink);
  }

  .glass-calculator__label:not(:first-of-type) {
    margin-top: 16px;
  }

  .glass-calculator__input,
  .glass-calculator__select,
  .glass-calculator__textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--white);
    color: var(--ink);
    font: inherit;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .glass-calculator__input,
  .glass-calculator__select {
    min-height: 56px;
    padding: 0 16px;
  }

  .glass-calculator__select {
    cursor: pointer;
  }

  .glass-calculator__input:disabled,
  .glass-calculator__select:disabled {
    background: #f5f8f8;
    color: var(--muted);
    cursor: not-allowed;
  }

  .glass-calculator__textarea {
    min-height: 112px;
    padding: 14px 18px;
    resize: vertical;
  }

  .glass-calculator__input:focus,
  .glass-calculator__select:focus,
  .glass-calculator__textarea:focus {
    border-color: #357299;
    box-shadow: 0 0 0 4px rgba(13, 95, 86, 0.14);
  }

  .glass-calculator__helper {
    margin-top: 14px;
    min-height: 22px;
    font-size: 14px;
    color: var(--muted);
  }

  .glass-calculator__range {
    margin-top: 14px;
    padding: 18px;
    border-radius: 8px;
    background: var(--blue-soft);
    border: 1px solid var(--line);
  }

  .glass-calculator__range > span,
  .glass-calculator__range small {
    display: block;
    color: var(--green-dark);
  }

  .glass-calculator__range strong {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin-top: 6px;
    font-size: clamp(26px, 4vw, 38px);
    line-height: 1;
    color: var(--ink);
  }

  .glass-calculator__range small {
    margin-top: 8px;
    line-height: 1.45;
  }

  :global(.glass-calculator__currency) {
    display: inline-flex;
    align-items: center;
    gap: 0.16em;
    color: inherit;
    white-space: nowrap;
  }

  :global(.glass-calculator__currency-icon) {
    display: inline-block;
    width: 0.58em;
    height: 0.72em;
    flex: 0 0 auto;
    background-color: currentColor;
    -webkit-mask: url('/byn-ico.svg') center / contain no-repeat;
    mask: url('/byn-ico.svg') center / contain no-repeat;
  }

  :global(.glass-calculator__range-dash) {
    color: var(--ink);
  }

  .glass-calculator__cta {
    display: flex;
    justify-content: center;
    margin-top: 18px;
    padding: 14px 18px;
    border: 0;
    border-radius: 8px;
    background: var(--amber);
    color: #241607;
    font: inherit;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
  }

  .glass-calculator__cta:hover {
    background: #f7b75e;
  }

  .glass-calculator__submit {
    width: 100%;
  }

  .glass-calculator__form-note {
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .glass-calculator__bot-field {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 820px) {
    .glass-calculator__inner,
    .glass-calculator__fields {
      grid-template-columns: 1fr;
    }

    .glass-calculator__panel {
      padding: 20px;
      border-radius: 8px;
    }

    .glass-calculator__tabs {
      grid-template-columns: 1fr;
    }
  }
</style>

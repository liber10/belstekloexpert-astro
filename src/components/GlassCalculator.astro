---
import prices from '../data/glass-prices.json';

const USD_TO_BYN_RATE = 3;
const INSTALLATION_WORK_USD = 50;

const calculatorPrices = prices.map((item) => ({
  id: item.id,
  name: item.name,
  eurocode: item.eurocode,
  years: item.years,
  totalPriceByn: Math.round((Number(item.glassPriceUsd) + INSTALLATION_WORK_USD) * USD_TO_BYN_RATE),
}));

const dataJson = JSON.stringify(calculatorPrices);
---

<section class="section section--soft glass-calculator" id="calculator" aria-labelledby="glass-calculator-title">
  <span class="anchor-offset" id="vin-form" aria-hidden="true"></span>
  <div class="container glass-calculator__inner">
    <div class="glass-calculator__copy">
      <p class="glass-calculator__eyebrow">Онлайн-расчёт</p>
      <h2 id="glass-calculator-title">Калькулятор стоимости установки автостекла</h2>
      <p>
        Быстрый расчёт по марке, модели и году показывает ориентировочную стоимость сразу.
        VIN используем отдельно — для точного ручного подбора стекла по комплектации автомобиля.
      </p>
      <p class="glass-calculator__note">
        Расчёт по модели предварительный: итог зависит от наличия стекла, датчика дождя/света,
        камеры, обогрева, молдингов, цвета полосы и состояния кузова.
      </p>
    </div>

    <div class="glass-calculator__panel" data-calculator>
      <div class="glass-calculator__tabs" role="tablist" aria-label="Выбор способа расчёта">
        <button
          class="glass-calculator__tab is-active"
          type="button"
          role="tab"
          aria-selected="true"
          data-mode-button="model"
        >
          Расчёт по модели
        </button>
        <button
          class="glass-calculator__tab"
          type="button"
          role="tab"
          aria-selected="false"
          data-mode-button="vin"
        >
          Подбор по VIN
        </button>
      </div>

      <div class="glass-calculator__mode" data-mode-panel="model">
        <label class="glass-calculator__label" for="glass-search">
          Марка, модель, год или еврокод
        </label>

        <div class="glass-calculator__search-row">
          <input
            id="glass-search"
            class="glass-calculator__input"
            type="search"
            placeholder="Например: Пежо 307 2002, Audi A6 2014, 8611AGN"
            autocomplete="off"
            data-search
          />
          <button class="glass-calculator__clear" type="button" data-clear aria-label="Очистить поиск">
            ×
          </button>
        </div>

        <div class="glass-calculator__helper" data-helper>
          Начните вводить марку, модель и год выпуска. Двигатель можно не указывать.
        </div>

        <div class="glass-calculator__range" data-range-summary hidden>
          <span>Ориентировочная стоимость с установкой</span>
          <strong data-range-price></strong>
        </div>
      </div>

      <div class="glass-calculator__mode" data-mode-panel="vin" hidden>
        <div class="glass-calculator__vin-intro">
          <h3>Точный подбор по VIN</h3>
          <p>
            VIN не рассчитывает цену автоматически по этому прайсу. Он помогает специалисту проверить
            комплектацию и подобрать правильное стекло: датчики, камеру, обогрев, молдинги и OEM-совместимость.
          </p>
        </div>

        <form
          class="glass-calculator__vin-form"
          name="glass-vin-request"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          data-vin-form
        >
          <input type="hidden" name="form-name" value="glass-vin-request" />
          <p class="glass-calculator__bot-field">
            <label>Не заполняйте это поле: <input name="bot-field" /></label>
          </p>
          <input type="hidden" name="decoded_vehicle" data-vin-decoded />

          <label class="glass-calculator__label" for="glass-vin">
            VIN автомобиля
          </label>
          <input
            id="glass-vin"
            class="glass-calculator__input"
            type="text"
            name="vin"
            inputmode="text"
            maxlength="17"
            pattern="[A-HJ-NPR-Z0-9]{17}"
            placeholder="Например: YV1LW570221342651"
            autocomplete="off"
            required
            data-vin-input
          />

          <div class="glass-calculator__helper" data-vin-helper>
            Введите 17 символов VIN. Буквы I, O и Q в VIN не используются.
          </div>

          <label class="glass-calculator__label" for="glass-phone">
            Телефон для связи
          </label>
          <input
            id="glass-phone"
            class="glass-calculator__input"
            type="tel"
            name="phone"
            placeholder="+375 / +48 / Viber / WhatsApp"
            autocomplete="tel"
            required
          />

          <label class="glass-calculator__label" for="glass-comment">
            Комментарий, если есть
          </label>
          <textarea
            id="glass-comment"
            class="glass-calculator__textarea"
            name="comment"
            rows="4"
            placeholder="Например: есть датчик дождя, камера, трещина со стороны водителя"
          ></textarea>

          <button class="glass-calculator__cta glass-calculator__submit" type="submit">
            Отправить VIN на подбор
          </button>

          <p class="glass-calculator__form-note">
            После проверки сообщим точную стоимость стекла и установки. Для мгновенной ориентировочной цены используйте расчёт по модели.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline type="application/json" id="glass-prices-json" set:html={dataJson}></script>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-calculator]');
    const source = document.getElementById('glass-prices-json');

    if (!root || !source) return;

    const MAX_MATCHES = 30;
    const prices = JSON.parse(source.textContent || '[]');

    const modeButtons = [...root.querySelectorAll('[data-mode-button]')];
    const modePanels = [...root.querySelectorAll('[data-mode-panel]')];

    const search = root.querySelector('[data-search]');
    const clearButton = root.querySelector('[data-clear]');
    const helper = root.querySelector('[data-helper]');
    const rangeSummary = root.querySelector('[data-range-summary]');
    const rangePrice = root.querySelector('[data-range-price]');

    const vinForm = root.querySelector('[data-vin-form]');
    const vinInput = root.querySelector('[data-vin-input]');
    const vinHelper = root.querySelector('[data-vin-helper]');
    const vinDecoded = root.querySelector('[data-vin-decoded]');

    const formatBynNumber = (value) => Math.round(Number(value)).toLocaleString('ru-RU');

    const formatBynLabel = (value) => `${formatBynNumber(value)} белорусских рублей`;

    const formatBynHtml = (value) => {
      const label = formatBynLabel(value);
      return `
        <span class="glass-calculator__currency" aria-label="${label}">
          <span>${formatBynNumber(value)}</span>
          <span class="glass-calculator__currency-icon" aria-hidden="true"></span>
        </span>
      `;
    };

    const BRAND_ALIASES = {
      'ауди': 'audi',
      'audi': 'audi',
      'бмв': 'bmw',
      'bmw': 'bmw',
      'мерседес': 'mercedes',
      'мерседес бенц': 'mercedes benz',
      'mercedes': 'mercedes',
      'фольксваген': 'volkswagen',
      'фольцваген': 'volkswagen',
      'фольц': 'volkswagen',
      'volkswagen': 'volkswagen',
      'vw': 'volkswagen',
      'шкода': 'skoda',
      'skoda': 'skoda',
      'пежо': 'peugeot',
      'peugeot': 'peugeot',
      'ситроен': 'citroen',
      'citroen': 'citroen',
      'рено': 'renault',
      'renault': 'renault',
      'опель': 'opel',
      'opel': 'opel',
      'форд': 'ford',
      'ford': 'ford',
      'тойота': 'toyota',
      'toyota': 'toyota',
      'ниссан': 'nissan',
      'nissan': 'nissan',
      'мазда': 'mazda',
      'mazda': 'mazda',
      'хонда': 'honda',
      'honda': 'honda',
      'хендай': 'hyundai',
      'хундай': 'hyundai',
      'hyundai': 'hyundai',
      'киа': 'kia',
      'kia': 'kia',
      'митсубиси': 'mitsubishi',
      'мицубиси': 'mitsubishi',
      'mitsubishi': 'mitsubishi',
      'субару': 'subaru',
      'subaru': 'subaru',
      'вольво': 'volvo',
      'volvo': 'volvo',
      'тесла': 'tesla',
      'tesla': 'tesla',
      'фиат': 'fiat',
      'сеат': 'seat',
      'лексус': 'lexus',
      'шевроле': 'chevrolet',
    };

    const IGNORED_QUERY_TOKENS = new Set([
      'дизель', 'дизеля', 'дизельный', 'бензин', 'бензиновый', 'газ',
      'diesel', 'dizel', 'hdi', 'tdi', 'tdci', 'dci', 'cdti', 'fsi', 'tsi',
    ]);

    const VIN_YEAR_CODES = {
      A: 2010, B: 2011, C: 2012, D: 2013, E: 2014, F: 2015, G: 2016, H: 2017, J: 2018,
      K: 2019, L: 2020, M: 2021, N: 2022, P: 2023, R: 2024, S: 2025, T: 2026,
      V: 2027, W: 2028, X: 2029, Y: 2000,
      1: 2001, 2: 2002, 3: 2003, 4: 2004, 5: 2005, 6: 2006, 7: 2007, 8: 2008, 9: 2009,
    };

    const VIN_WMI_BRANDS = {
      YV1: 'VOLVO', YV4: 'VOLVO',
      WAU: 'AUDI', WUA: 'AUDI', TRU: 'AUDI',
      WBA: 'BMW', WBS: 'BMW',
      WDB: 'MERCEDES', WDD: 'MERCEDES', WDC: 'MERCEDES',
      WVW: 'VOLKSWAGEN', WVG: 'VOLKSWAGEN', WV1: 'VOLKSWAGEN', WV2: 'VOLKSWAGEN',
      VF3: 'PEUGEOT', VF7: 'CITROEN', VF1: 'RENAULT',
      W0L: 'OPEL', WF0: 'FORD',
      JT1: 'TOYOTA', JT2: 'TOYOTA', JTD: 'TOYOTA',
      JN1: 'NISSAN', JM1: 'MAZDA', JHM: 'HONDA', KMH: 'HYUNDAI', KNA: 'KIA',
    };

    const VIN_MODEL_HINTS = {
      YV1LW: { model: 'V70', note: 'платформа Volvo 850/S70/V70/C70' },
      YV1LS: { model: 'S70', note: 'платформа Volvo 850/S70/V70/C70' },
      YV1SW: { model: 'V70', note: 'Volvo V70 второго поколения' },
      YV1TS: { model: 'S80', note: 'Volvo S80 первого поколения' },
    };

    const cleanVin = (value) => String(value || '').toUpperCase().replace(/[^A-Z0-9]/g, '');

    const decodeVin = (value) => {
      const vin = cleanVin(value);
      if (!/^[A-HJ-NPR-Z0-9]{17}$/.test(vin)) return null;

      const wmi = vin.slice(0, 3);
      const modelKey = vin.slice(0, 5);
      const make = VIN_WMI_BRANDS[wmi] || '';
      const year = VIN_YEAR_CODES[vin[9]] || null;
      const modelHint = VIN_MODEL_HINTS[modelKey] || null;

      return {
        vin,
        make,
        year,
        model: modelHint?.model || '',
        note: modelHint?.note || '',
      };
    };

    const normalize = (value) => {
      const tokens = String(value || '')
        .toLowerCase()
        .replace(/ё/g, 'е')
        .replace(/[^a-zа-я0-9]+/gi, ' ')
        .trim()
        .split(/\s+/)
        .filter(Boolean)
        .map((token) => BRAND_ALIASES[token] || token);

      return tokens.join(' ');
    };

    const isYearToken = (token) => /^(19|20)\d{2}$/.test(token);

    const parseYearBounds = (yearText) => {
      const value = String(yearText || '');
      const rangeMatch = value.match(/((?:19|20)\d{2})\s*[-–]\s*(Q|\d{2}|(?:19|20)\d{2})/i);

      if (rangeMatch) {
        const start = Number(rangeMatch[1]);
        let end;

        if (/^q$/i.test(rangeMatch[2])) {
          end = 9999;
        } else if (/^\d{2}$/.test(rangeMatch[2])) {
          const century = Math.floor(start / 100) * 100;
          end = century + Number(rangeMatch[2]);
          if (end < start) end += 100;
        } else {
          end = Number(rangeMatch[2]);
        }

        return [start, end];
      }

      const years = value.match(/(?:19|20)\d{2}/g)?.map(Number) || [];
      if (years.length >= 2) return [Math.min(...years), Math.max(...years)];
      if (years.length === 1) return [years[0], /[-–]\s*Q/i.test(value) ? 9999 : years[0]];
      return [null, null];
    };

    const yearMatches = (yearText, year) => {
      const [start, end] = parseYearBounds(yearText);
      if (!start || !end) return true;
      return year >= start && year <= end;
    };

    const getQueryParts = (value) => {
      const normalized = normalize(value);
      const rawTokens = normalized.split(' ').filter(Boolean);
      const years = rawTokens.filter(isYearToken).map(Number);
      const tokens = rawTokens.filter((token) => {
        if (token.length <= 1) return false;
        if (isYearToken(token)) return false;
        if (IGNORED_QUERY_TOKENS.has(token)) return false;
        return true;
      });

      return {
        query: tokens.join(' '),
        tokens,
        years,
      };
    };

    const searchablePrices = prices.map((item) => ({
      ...item,
      searchText: normalize(`${item.name} ${item.eurocode} ${item.years}`),
      normalizedName: normalize(item.name),
      normalizedEurocode: normalize(item.eurocode),
    }));

    const scoreItem = (item, tokens, query, years) => {
      let score = 0;

      for (const year of years) {
        if (!yearMatches(item.years, year)) return -1;
        score += 10;
      }

      for (const token of tokens) {
        if (!item.searchText.includes(token)) return -1;

        if (item.searchText.startsWith(token)) score += 6;
        else score += 2;

        if (item.normalizedEurocode.startsWith(token)) score += 8;
        if (item.normalizedName.startsWith(token)) score += 5;
      }

      if (query && item.searchText.includes(query)) score += 4;

      return score;
    };

    const findMatches = ({ query, tokens, years }) => {
      return searchablePrices
        .map((item) => ({ item, score: scoreItem(item, tokens, query, years) }))
        .filter((entry) => entry.score >= 0)
        .sort((a, b) => b.score - a.score || a.item.totalPriceByn - b.item.totalPriceByn)
        .slice(0, MAX_MATCHES)
        .map((entry) => entry.item);
    };

    const renderEmpty = (message) => {
      rangeSummary.hidden = true;
      helper.textContent = message;
    };

    const renderRange = (items) => {
      if (!items.length) {
        rangeSummary.hidden = true;
        return;
      }

      const totals = items.map((item) => Number(item.totalPriceByn));
      const min = Math.min(...totals);
      const max = Math.max(...totals);

      rangePrice.innerHTML = min === max
        ? formatBynHtml(min)
        : `${formatBynHtml(min)} <span class="glass-calculator__range-dash">–</span> ${formatBynHtml(max)}`;
      rangePrice.setAttribute('aria-label', min === max ? formatBynLabel(min) : `${formatBynLabel(min)} – ${formatBynLabel(max)}`);
      rangeSummary.hidden = false;
    };

    const renderMatches = (items) => {
      if (!items.length) {
        renderEmpty('Ничего не найдено. Попробуйте марку + модель + год или еврокод. Для точного подбора отправьте VIN.');
        return;
      }

      helper.textContent = 'Показан ориентировочный диапазон с установкой. Для точного подбора по комплектации отправьте VIN.';
      renderRange(items);
    };

    const handleSearch = () => {
      const cleanedVin = cleanVin(search.value);

      if (/^[A-HJ-NPR-Z0-9]{17}$/.test(cleanedVin)) {
        renderEmpty('Это похоже на VIN. Для VIN используйте вкладку «Подбор по VIN» — цена по нему не рассчитывается автоматически.');
        return;
      }

      const { query, tokens, years } = getQueryParts(search.value);

      if (!tokens.length) {
        renderEmpty('Начните вводить марку или модель. Один год без модели не даст полезный расчёт.');
        return;
      }

      const found = findMatches({ query, tokens, years });
      renderMatches(found);
    };

    const setMode = (mode) => {
      modeButtons.forEach((button) => {
        const isActive = button.dataset.modeButton === mode;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-selected', String(isActive));
      });

      modePanels.forEach((panel) => {
        panel.hidden = panel.dataset.modePanel !== mode;
      });

      if (mode === 'model') search?.focus();
      if (mode === 'vin') vinInput?.focus();
    };

    const updateVinState = () => {
      const cleaned = cleanVin(vinInput.value);
      if (cleaned !== vinInput.value) vinInput.value = cleaned;

      if (!cleaned) {
        vinHelper.textContent = 'Введите 17 символов VIN. Буквы I, O и Q в VIN не используются.';
        vinDecoded.value = '';
        return;
      }

      if (cleaned.length < 17) {
        vinHelper.textContent = `Осталось символов: ${17 - cleaned.length}. После отправки специалист подберёт стекло вручную.`;
        vinDecoded.value = '';
        return;
      }

      const vinInfo = decodeVin(cleaned);
      if (!vinInfo) {
        vinHelper.textContent = 'VIN должен состоять из 17 символов без букв I, O и Q.';
        vinDecoded.value = '';
        return;
      }

      const vehicle = [vinInfo.make, vinInfo.model, vinInfo.year].filter(Boolean).join(' ');
      const note = vinInfo.note ? ` ${vinInfo.note}.` : '';
      const label = vehicle || 'марка/модель не определены локальным справочником';

      vinDecoded.value = `${label}${note}`.trim();
      vinHelper.textContent = `VIN принят: ${label}.${note} Цена не рассчитывается автоматически — заявка отправляется специалисту на точный подбор.`;
    };

    modeButtons.forEach((button) => {
      button.addEventListener('click', () => setMode(button.dataset.modeButton));
    });

    search.addEventListener('input', handleSearch);

    clearButton.addEventListener('click', () => {
      search.value = '';
      renderEmpty('Начните вводить марку, модель и год выпуска. Двигатель можно не указывать.');
      search.focus();
    });

    vinInput.addEventListener('input', updateVinState);
    vinForm.addEventListener('submit', (event) => {
      updateVinState();
      if (!decodeVin(vinInput.value)) {
        event.preventDefault();
        vinInput.focus();
      }
    });

  })();
</script>

<style>
  .glass-calculator {
    position: relative;
  }

  .glass-calculator__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
    gap: 32px;
    align-items: start;
  }

  .anchor-offset {
    position: absolute;
    top: -92px;
  }

  .glass-calculator__eyebrow {
    margin: 0 0 10px;
    font-size: 0.82rem;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--green);
  }

  .glass-calculator h2 {
    margin: 0 0 18px;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.05;
    color: var(--ink);
  }

  .glass-calculator h3 {
    margin: 0 0 10px;
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--ink);
  }

  .glass-calculator__copy p,
  .glass-calculator__vin-intro p,
  .glass-calculator__form-note {
    margin: 0 0 16px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--muted);
  }

  .glass-calculator__note {
    padding: 16px 18px;
    border-left: 4px solid var(--green);
    border-radius: 8px;
    background: var(--white);
  }

  .glass-calculator__panel {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .glass-calculator__tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 22px;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
  }

  .glass-calculator__tab {
    min-height: 44px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .glass-calculator__tab.is-active {
    background: var(--white);
    color: var(--ink);
    box-shadow: 0 8px 20px rgba(13, 38, 35, 0.08);
  }

  .glass-calculator__label {
    display: block;
    margin: 0 0 10px;
    font-weight: 700;
    color: var(--ink);
  }

  .glass-calculator__label:not(:first-of-type) {
    margin-top: 16px;
  }

  .glass-calculator__search-row {
    position: relative;
  }

  .glass-calculator__input,
  .glass-calculator__textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--white);
    color: var(--ink);
    font: inherit;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .glass-calculator__input {
    min-height: 56px;
    padding: 0 52px 0 18px;
  }

  .glass-calculator__textarea {
    min-height: 112px;
    padding: 14px 18px;
    resize: vertical;
  }

  .glass-calculator__input:focus,
  .glass-calculator__textarea:focus {
    border-color: #357299;
    box-shadow: 0 0 0 4px rgba(13, 95, 86, 0.14);
  }

  .glass-calculator__clear {
    position: absolute;
    top: 50%;
    right: 10px;
    width: 36px;
    height: 36px;
    transform: translateY(-50%);
    border: 0;
    border-radius: 999px;
    background: var(--blue-soft);
    color: var(--muted);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }

  .glass-calculator__helper {
    margin-top: 10px;
    min-height: 22px;
    font-size: 14px;
    color: var(--muted);
  }

  .glass-calculator__range {
    margin-top: 14px;
    padding: 18px;
    border-radius: 8px;
    background: var(--blue-soft);

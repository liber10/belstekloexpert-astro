---
import SectionTitle from '@/components/common/SectionTitle.astro';

const questions = [
  {
    question: 'Когда можно ехать после замены лобового стекла?',
    answer:
      'Обычно автомобиль можно забирать после технологической выдержки клея. Точное время зависит от состава, температуры и условий установки.',
  },
  {
    question: 'Можно ли рассчитать цену без визита?',
    answer:
      'Да. Чаще всего достаточно телефона, VIN или марки, модели, года и фото повреждения.',
  },
  {
    question: 'Что влияет на стоимость замены?',
    answer:
      'Марка, модель, год, тип стекла, обогрев, датчик дождя, камера, молдинги и наличие стекла у поставщиков.',
  },
  {
    question: 'Когда скол уже не ремонтируется?',
    answer:
      'Если повреждение крупное, пошла длинная трещина или скол находится в критичной зоне, безопаснее обсудить замену стекла.',
  },
];
---

<section class="section" id="faq">
  <div class="container">
    <SectionTitle
      eyebrow="FAQ"
      title="Короткие ответы на частые вопросы"
      lead="Если ситуация спорная, лучше отправить фото: мастер подскажет, ремонтировать или менять."
    />
    <div class="faq-list">
      {questions.map((item) => (
        <details class="faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

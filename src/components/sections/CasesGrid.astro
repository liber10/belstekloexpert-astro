---
import SectionTitle from '@/components/common/SectionTitle.astro';
import { getCollection } from 'astro:content';

const cases = (await getCollection('cases')).slice(0, 3);
---

<section class="section">
  <div class="container">
    <SectionTitle
      eyebrow="Кейсы"
      title="Типовые ситуации, с которыми приезжают в бокс"
      lead="Кейсы помогают быстро понять, когда стекло можно спасти ремонтом, а когда лучше не тянуть с заменой."
    />
    <div class="grid case-grid">
      {cases.map((item) => (
        <article class="card case-card">
          <h3>{item.data.title}</h3>
          <p>{item.data.service} · {item.data.duration} · {item.data.price}</p>
          <small>{item.body}</small>
        </article>
      ))}
    </div>
  </div>
</section>

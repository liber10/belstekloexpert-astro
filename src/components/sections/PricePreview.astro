---
import Button from '@/components/common/Button.astro';
import SectionTitle from '@/components/common/SectionTitle.astro';
import { prices, priceNote, pricePackages } from '@/data/prices';
---

<section class="section section--soft" id="prices">
  <div class="container">
    <SectionTitle
      eyebrow="Цены"
      title="Стартовые цены для ориентира"
      lead={priceNote}
    />
    <div class="grid package-grid package-grid--compact">
      {pricePackages.map((item) => (
        <a class="card package-card" href="/kalkulyator/" data-event={item.eventName}>
          <p class="package-card__label">{item.title}</p>
          <h3>от {item.priceFrom} {item.unit}</h3>
          <p>{item.text}</p>
        </a>
      ))}
    </div>
    <div class="grid price-grid">
      {prices.map((item) => (
        <a class="card price-card" href={item.url}>
          <h3>{item.title}</h3>
          <p>от {item.priceFrom} {item.unit}</p>
        </a>
      ))}
    </div>
    <div class="cta-row">
      <Button href="/ceny/">Смотреть цены</Button>
      <Button href="#vin-form" variant="quiet">Уточнить по VIN</Button>
    </div>
  </div>
</section>

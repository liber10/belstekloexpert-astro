---
import Button from '@/components/common/Button.astro';
import Currency from '@/components/common/Currency.astro';
import SectionTitle from '@/components/common/SectionTitle.astro';
import { brands } from '@/data/brands';

const visibleBrands = brands.slice(0, 8);
---

<section class="section section--soft" id="brands">
  <div class="container">
    <SectionTitle
      eyebrow="Марки авто"
      title="Посадочные страницы под частые модели"
      lead="Для первой оценки нужны марка, модель, год и фото стекла. Датчики, камеру, обогрев и другие особенности по снимку проверяет мастер."
    />
    <div class="grid brand-grid">
      {visibleBrands.map((brand) => (
        <a class="card brand-card" href={`/marki/${brand.slug}/`}>
          <h3>{brand.name}</h3>
          <p><Currency value={brand.priceFrom} suffix="под ключ" /></p>
          <span>{brand.models.map((model) => model.name).join(' · ')}</span>
        </a>
      ))}
    </div>
    <div class="cta-row">
      <Button href="/marki/">Все марки</Button>
      <Button href="/#calculator" variant="quiet">Не нашли модель</Button>
    </div>
  </div>
</section>

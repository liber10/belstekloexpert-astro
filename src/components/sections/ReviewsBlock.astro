---
import SectionTitle from '@/components/common/SectionTitle.astro';

const reviews = [
  {
    title: 'Что просим указать',
    text: 'Марку авто, выполненную работу, скорость ответа, аккуратность салона и совпала ли цена с расчётом.',
  },
  {
    title: 'Где собираем',
    text: 'В первую очередь в Яндекс Картах, Google Maps и 2ГИС, чтобы отзыв был привязан к реальному месту.',
  },
  {
    title: 'Что не делаем',
    text: 'Не публикуем неподтверждённые отзывы как реальные и не маскируем заготовки под клиентские истории.',
  },
];
---

<section class="section section--soft">
  <div class="container">
    <SectionTitle
      eyebrow="Отзывы"
      title="Отзывы должны быть проверяемыми"
      lead="На старте важнее собрать честную базу в картах, чем заполнить сайт красивыми, но неподтверждёнными цитатами."
    />
    <div class="grid review-grid">
      {reviews.map((item) => (
        <article class="card review-card">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

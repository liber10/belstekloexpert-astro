---
import Currency from '@/components/common/Currency.astro';
import SectionTitle from '@/components/common/SectionTitle.astro';
import { prices } from '@/data/prices';
---

<section class="section" id="services">
  <div class="container">
    <SectionTitle
      eyebrow="Услуги"
      title="Закрываем срочные задачи со стеклом без лишних кругов"
      lead="От скола после трассы до полной замены стекла. Для быстрой оценки пришлите автомобиль и фото — технические особенности проверит мастер."
    />
    <div class="grid service-grid">
      {prices.map((item) => (
        <a class="card service-card" href={item.url}>
          <div>
            <h3>{item.title}</h3>
            <p>
              {item.url === '/remont-skolov/'
                ? 'Предварительная оценка по фото, запись в бокс и честный ответ о ремонтопригодности.'
                : 'Подбор, согласование цены, запись на удобное время и рекомендации после работы.'}
            </p>
          </div>
          <div class="price-line">
            {item.priceFrom > 0 ? <Currency value={item.priceFrom} suffix={item.unit} /> : 'по оценке фото'}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

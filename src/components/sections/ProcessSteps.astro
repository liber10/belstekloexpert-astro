---
import SectionTitle from '@/components/common/SectionTitle.astro';

const steps = [
  {
    title: 'Заявка',
    text: 'Вы отправляете марку, модель, год, телефон и фото лобового стекла.',
  },
  {
    title: 'Расчёт',
    text: 'Мастер сам определяет особенности стекла и проверяет варианты у поставщиков.',
  },
  {
    title: 'Запись',
    text: 'Подбираем время в боксе или обсуждаем выезд по Минску.',
  },
  {
    title: 'Работа',
    text: 'Выполняем замену или ремонт, проверяем рабочую зону и даём рекомендации после выдачи.',
  },
];
---

<section class="section">
  <div class="container">
    <SectionTitle
      eyebrow="Процесс"
      title="Путь от заявки до выдачи понятен мастеру и клиенту"
      lead="Заявка должна быстро превращаться в конкретную цену, время записи и понятные действия после замены."
    />
    <div class="grid steps">
      {steps.map((step) => (
        <article class="card step">
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

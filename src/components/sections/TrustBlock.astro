---
import SectionTitle from '@/components/common/SectionTitle.astro';

const items = [
  {
    title: 'Подбор по VIN, не “на глаз”',
    text: 'Уточняем стекло, молдинги, датчик дождя, камеру, обогрев и другие особенности комплектации.',
  },
  {
    title: 'Цена до записи',
    text: 'Сразу объясняем вилку стоимости и заранее называем, что может повлиять на итог.',
  },
  {
    title: 'Гарантия на шов',
    text: 'Аккуратно работаем с кузовом, герметиком и посадкой стекла, чтобы после замены не было протечек.',
  },
  {
    title: 'Салон остаётся чистым',
    text: 'Закрываем рабочие зоны и убираем следы демонтажа, клея и старого стекла перед выдачей.',
  },
  {
    title: 'Датчики и камера',
    text: 'Согласуем сложные комплектации до заказа стекла и объясняем, когда нужна дополнительная проверка.',
  },
  {
    title: 'Бокс или выезд',
    text: 'Предлагаем удобный формат, но не берём выезд, если условия мешают сделать работу безопасно.',
  },
];
---

<section class="section section--soft">
  <div class="container">
    <SectionTitle
      eyebrow="Доверие"
      title="Сначала точность, потом установка"
      lead="Автостекло редко выбирают “на глаз”. Ошибка в датчике, обогреве или камере стоит времени и денег, поэтому расчёт начинается с комплектации автомобиля."
    />
    <div class="grid feature-grid">
      {items.map((item) => (
        <article class="card feature-card">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

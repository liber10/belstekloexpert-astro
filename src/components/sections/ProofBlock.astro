---
import SectionTitle from '@/components/common/SectionTitle.astro';

const items = [
  {
    title: 'Защита салона и торпедо',
    text: 'Перед работой закрываем зоны риска, чтобы клей, пыль и старый герметик не оставались в салоне.',
  },
  {
    title: 'Пневмонож и аккуратный демонтаж',
    text: 'Используем инструмент, который помогает снять стекло без грубой нагрузки на кузов и интерьер.',
  },
  {
    title: 'Свежие материалы',
    text: 'Согласуем стекло, расходники и герметик до записи, чтобы работа не превращалась в импровизацию.',
  },
  {
    title: 'Датчики, камера, обогрев',
    text: 'Проверяем опции комплектации до заказа стекла и объясняем, что влияет на итоговую цену.',
  },
  {
    title: 'Чистая выдача',
    text: 'После ремонта или замены убираем рабочую зону и проговариваем ограничения на первые сутки.',
  },
  {
    title: 'Гарантия герметичности',
    text: 'Даём понятную гарантию на герметичность шва и объясняем, когда можно ехать на мойку.',
  },
];
---

<section class="section">
  <div class="container">
    <SectionTitle
      eyebrow="Как работаем"
      title="Аккуратность важнее громких обещаний"
      lead="Сильная сторона сервиса — не только поставить стекло, а сделать это предсказуемо: без грязного салона, сюрпризов по цене и ошибок в комплектации."
    />
    <div class="grid feature-grid">
      {items.map((item) => (
        <article class="card feature-card">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

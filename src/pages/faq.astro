---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { faqPageSchema } from '@/lib/schema';
import { site } from '@/data/site';

const entries = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
const schema = faqPageSchema(
  entries.map((entry) => ({
    question: entry.data.question,
    answer: (entry.body ?? '').trim(),
  })),
);
---

<BaseLayout
  title="FAQ по замене и ремонту автостёкол — BelStekloExpert"
  description="Ответы на частые вопросы по замене лобового стекла, ремонту сколов, трещин, оценке по фото и выезду."
  canonical={`${site.domain}/faq/`}
  schema={schema}
>
  <section class="section section--soft">
    <div class="container">
      <p class="section__eyebrow">FAQ</p>
      <h1 class="section__title">Частые вопросы</h1>
      <p class="section__lead">
        Собрали вопросы, которые чаще всего появляются до записи на ремонт или замену стекла.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="faq-list">
        {rendered.map(({ entry, Content }) => (
          <details class="faq-item">
            <summary>{entry.data.question}</summary>
            <div class="faq-answer"><Content /></div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

---
import FinalCTA from '@/components/sections/FinalCTA.astro';
import FAQBlock from '@/components/sections/FAQBlock.astro';
import BrandTeaser from '@/components/sections/BrandTeaser.astro';
import Hero from '@/components/sections/Hero.astro';
import MapBlock from '@/components/sections/MapBlock.astro';
import PricePackages from '@/components/sections/PricePackages.astro';
import ProofBlock from '@/components/sections/ProofBlock.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import ReviewRequestBlock from '@/components/sections/ReviewRequestBlock.astro';
import ServiceSummaryBlock from '@/components/sections/ServiceSummaryBlock.astro';
import ServiceCards from '@/components/sections/ServiceCards.astro';
import TrustBlock from '@/components/sections/TrustBlock.astro';
import CasesGrid from '@/components/sections/CasesGrid.astro';
import VinPhotoForm from '@/components/forms/VinPhotoForm.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
---

<BaseLayout title={site.defaultTitle} description={site.defaultDescription} canonical={`${site.domain}/`}>
  <Hero />
  <ServiceCards />
  <section class="section section--soft">
    <div class="container">
      <VinPhotoForm />
    </div>
  </section>
  <TrustBlock />
  <ProofBlock />
  <ProcessSteps />
  <PricePackages soft />
  <BrandTeaser />
  <CasesGrid />
  <ReviewRequestBlock />
  <FAQBlock />
  <ServiceSummaryBlock soft />
  <MapBlock />
  <FinalCTA />
</BaseLayout>

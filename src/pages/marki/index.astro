---
import Button from '@/components/common/Button.astro';
import VinPhotoForm from '@/components/forms/VinPhotoForm.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { brands } from '@/data/brands';
import { site } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';

const schema = breadcrumbSchema([
  { name: 'Главная', url: `${site.domain}/` },
  { name: 'Марки авто', url: `${site.domain}/marki/` },
]);
---

<BaseLayout
  title="Замена автостёкол по маркам авто в Минске — BelStekloExpert"
  description="Посадочные страницы по популярным маркам авто: Volkswagen, Skoda, Geely, Renault, Kia, Hyundai, Toyota, BMW, Audi и другим."
  canonical={`${site.domain}/marki/`}
  schema={schema}
>
  <section class="section section--soft">
    <div class="container">
      <p class="section__eyebrow">Марки авто</p>
      <h1 class="section__title">Подбор и замена автостёкол по маркам</h1>
      <p class="section__lead">
        Выберите марку, чтобы увидеть частые модели и быстро отправить VIN или
        фото маркировки стекла. Если модели нет в списке, всё равно рассчитаем вручную.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid brand-grid">
        {brands.map((brand) => (
          <a class="card brand-card" href={`/marki/${brand.slug}/`}>
            <h3>{brand.name}</h3>
            <p>от {brand.priceFrom} BYN под ключ</p>
            <span>{brand.models.map((model) => model.name).join(' · ')}</span>
          </a>
        ))}
      </div>
      <div class="cta-row">
        <Button href="/#calculator">Рассчитать другую марку</Button>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <VinPhotoForm title="Не нашли марку или модель?" service="Марки авто" />
    </div>
  </section>
</BaseLayout>

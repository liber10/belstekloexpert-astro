---
import GlassCalculator from '@/components/GlassCalculator.astro';
import PricePackages from '@/components/sections/PricePackages.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
---

<BaseLayout
  title="Оценка лобового стекла по фото в Минске — BelStekloExpert"
  description="Отправьте марку, модель, год и фото лобового стекла. Мастер определит важные опции и предложит подходящий вариант. Прайс-калькулятор остаётся для ориентира."
  canonical={`${site.domain}/kalkulyator/`}
>
  <section class="section section--soft">
    <div class="container">
      <p class="section__eyebrow">Оценка без сложной анкеты</p>
      <h1 class="section__title">Оценка лобового стекла по марке, модели, году и фото</h1>
      <p class="section__lead">
        Не нужно самостоятельно определять датчики, камеры и комплектацию. Мастер
        посмотрит фото, сверит автомобиль и вернёт подходящие варианты со стоимостью.
      </p>
    </div>
  </section>
  <GlassCalculator />
  <PricePackages showExamples={false} />
  <section class="section section--soft">
    <div class="container content-flow">
      <p class="section__eyebrow">Как сфотографировать</p>
      <h2>Один общий кадр и крупный план повреждения</h2>
      <p>
        Снимите лобовое стекло целиком снаружи автомобиля. Если есть скол или
        трещина, добавьте крупный план при дневном свете. Большие JPG, PNG и WebP
        автоматически сжимаются перед отправкой.
      </p>
      <p>
        VIN может понадобиться позже для финальной сверки сложной комплектации, но
        для быстрой первичной оценки он не обязателен.
      </p>
    </div>
  </section>
</BaseLayout>

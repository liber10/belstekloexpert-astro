---
import VinPhotoForm from '@/components/forms/VinPhotoForm.astro';
import PricePackages from '@/components/sections/PricePackages.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
---

<BaseLayout
  title="Калькулятор автостёкол — BelStekloExpert"
  description="Быстрый расчёт стоимости замены или ремонта автостекла по VIN, фото и параметрам автомобиля."
  canonical={`${site.domain}/kalkulyator/`}
>
  <section class="section section--soft">
    <div class="container">
      <p class="section__eyebrow">Расчёт</p>
      <h1 class="section__title">Калькулятор стоимости автостекла</h1>
      <p class="section__lead">
        Быстрый расчёт работает через VIN, фото маркировки или параметры автомобиля.
        Мастер видит заявку в Telegram, уточняет стекло и возвращает цену с учётом опций.
      </p>
    </div>
  </section>
  <PricePackages showExamples={false} />
  <section class="section section--soft">
    <div class="container content-flow">
      <p class="section__eyebrow">Что ускорит расчёт</p>
      <h2>Лучше отправить VIN и фото повреждения</h2>
      <p>
        VIN помогает подобрать стекло без ошибки, а фото показывает, можно ли ремонтировать
        скол или трещину без полной замены. Большие JPG, PNG и WebP автоматически
        сжимаются перед отправкой.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <VinPhotoForm title="Рассчитать стоимость" service="Калькулятор" />
    </div>
  </section>
</BaseLayout>

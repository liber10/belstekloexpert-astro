---
import Footer from '@/components/common/Footer.astro';
import Header from '@/components/common/Header.astro';
import StickyCallBar from '@/components/common/StickyCallBar.astro';
import CookieConsent from '@/components/common/CookieConsent.astro';
import { autoRepairSchema, organizationSchema } from '@/lib/schema';
import { site } from '@/data/site';
import '@/styles/global.css';

type JsonLd = Record<string, unknown> | Array<Record<string, unknown>>;

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  schema?: JsonLd;
}

const {
  title = site.defaultTitle,
  description = site.defaultDescription,
  canonical = `${site.domain}${Astro.url.pathname}`,
  image = '/images/hero-autoglass.png',
  noindex = false,
  schema,
} = Astro.props;

const absoluteImage = image.startsWith('http') ? image : `${site.domain}${image}`;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const ga4Id = import.meta.env.PUBLIC_GA4_ID;
const ymId = import.meta.env.PUBLIC_YANDEX_METRIKA_ID;
const baseSchema = [organizationSchema(), autoRepairSchema()];
const schemas = Array.isArray(schema) ? [...baseSchema, ...schema] : schema ? [...baseSchema, schema] : baseSchema;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="yandex-verification" content="9978e4ac98b1f076" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0d5f56" />
    <link rel="icon" href="/favicon.png?v=3" type="image/png" />
    <link rel="alternate icon" href="/favicon.ico?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemas)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <StickyCallBar />
    <CookieConsent gtmId={gtmId} ga4Id={ga4Id} ymId={ymId} />

    <script is:inline define:vars={{ yandexMetrikaId: ymId }}>
      (() => {
        const attributionKeys = [
          'utm_source',
          'utm_medium',
          'utm_campaign',
          'utm_content',
          'utm_term',
          'gclid',
          'gbraid',
          'wbraid',
          'yclid',
          'fbclid',
        ];
        const storageKey = 'belstekloexpert_utm';
        const params = new URLSearchParams(window.location.search);
        const ymCounterId = Number(yandexMetrikaId);
        let saved = {};

        window.bseTrack = (eventName, eventParams = {}) => {
          if (!eventName || window.bseAnalyticsAllowed !== true) return;

          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: eventName, ...eventParams });

          if (typeof window.gtag === 'function') {
            window.gtag('event', eventName, eventParams);
          }

          if (Number.isFinite(ymCounterId) && ymCounterId > 0 && typeof window.ym === 'function') {
            window.ym(ymCounterId, 'reachGoal', eventName, eventParams);
          }
        };

        try {
          saved = JSON.parse(window.localStorage.getItem(storageKey) || '{}');
        } catch {
          saved = {};
        }

        const next = { ...saved };
        attributionKeys.forEach((key) => {
          const value = params.get(key);
          if (value) next[key] = value;
        });
        if (!next.landing_url) next.landing_url = window.location.href;
        if (!next.referrer && document.referrer) next.referrer = document.referrer;

        try {
          window.localStorage.setItem(storageKey, JSON.stringify(next));
        } catch {
          // Form submission still works without localStorage.
        }

        document.querySelectorAll('[data-attribution-field], [data-utm-field]').forEach((field) => {
          const input = field;
          const key = input.getAttribute('name');
          if (key && next[key]) input.value = next[key];
        });

        document.querySelectorAll('[data-page-url]').forEach((field) => {
          field.value = window.location.href;
        });

        document.querySelectorAll('[data-submission-id]').forEach((field) => {
          if (!field.value) field.value = createSubmissionId();
        });

        document.addEventListener('click', (event) => {
          const target =
            event.target instanceof Element ? event.target.closest('[data-event]') : null;
          if (!target) return;
          const eventName = target.getAttribute('data-event');
          window.bseTrack(eventName, {
            event_url: target instanceof HTMLAnchorElement ? target.href : window.location.href,
            event_text: target.textContent?.trim().slice(0, 80) || undefined,
          });
        });

        document.addEventListener('change', (event) => {
          const input = event.target instanceof HTMLInputElement ? event.target : null;
          if (!input || input.type !== 'file') return;

          const files = Array.from(input.files || []);
          if (!files.length) return;

          window.bseTrack('photo_select', {
            photo_count: files.length,
            total_bytes: files.reduce((sum, file) => sum + file.size, 0),
          });
        });

        document.addEventListener('submit', (event) => {
          const form =
            event.target instanceof HTMLFormElement && event.target.matches('form[data-lead-form]')
              ? event.target
              : null;
          if (!form) return;

          const submissionId = form.querySelector('[data-submission-id]');
          if (submissionId && !submissionId.value) submissionId.value = createSubmissionId();
          const consentAt = form.querySelector('[data-consent-at]');
          if (consentAt) consentAt.value = new Date().toISOString();

          const honeypot = form.querySelector('[name="company"]');
          const phone = form.querySelector('[name="phone"]');
          const status = form.querySelector('[data-form-status]');

          if (honeypot?.value) {
            event.preventDefault();
            return;
          }

          const digits = phone?.value.replace(/\D/g, '') || '';
          if (digits.length < 9) {
            event.preventDefault();
            if (status) status.textContent = 'Укажите телефон, чтобы мастер смог связаться с вами.';
            phone?.focus();
            return;
          }

          const eventName = form.getAttribute('data-submit-event') || 'service_lead_submit';
          window.bseTrack(eventName, {
            form_service: form.querySelector('[name="service"]')?.value || 'unknown',
          });
        });

        function createSubmissionId() {
          if (window.crypto && typeof window.crypto.randomUUID === 'function') {
            return window.crypto.randomUUID();
          }

          return `web_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 12)}`;
        }
      })();
    </script>
  </body>
</html>
